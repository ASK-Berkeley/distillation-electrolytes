; Triflate anion, CF3SO3- (OTf-)
;
; Source: CL&P force field (Canongia Lopes & Padua), file il.ff, entries
; "triflate and bistriflamide JPCB108(2004)16893" and "triflate PCCP 43 (2017) 29617":
;   Canongia Lopes, Padua, J. Phys. Chem. B 108, 16893 (2004), doi:10.1021/jp0476545
;     (Lennard-Jones, bonds, angles, dihedral)
;   Gouveia et al., Phys. Chem. Chem. Phys. 19, 29617 (2017), doi:10.1039/C7CP06081E
;     (triflate oxygen charge -0.63, type OTF in il.ff)
; CL&P is built on the OPLS-AA functional form: geometric combination rules,
; 1-4 interactions scaled by 0.5, harmonic bonds and angles, V = k/2 (x - x0)^2,
; OPLS Fourier dihedrals. il.ff bond constants (kJ/mol/A^2) are multiplied by
; 100 below to get kJ/mol/nm^2.
;
; Charges (il.ff): C +0.35, S +1.02, O -0.63 (x3), F -0.16 (x3); total -1.00.
; Lennard-Jones types clp_CBT / clp_SBT / clp_OTF / clp_F1 are defined in the
; combined forcefield file written by lib/build_system_lpg.py.
;
; Exclusions: nrexcl 3 (OPLS). The only 1-4 pairs are the nine O...F pairs
; across the S-C bond; those are listed in [ pairs ] and get the 0.5-scaled
; interaction through gen-pairs.
;
; Dihedral: il.ff "OB SB CF FB opls 0 0 1.451 0" is the OPLS Fourier series
; V = 1/2 [V1(1+cos phi) + V2(1-cos 2phi) + V3(1+cos 3phi) + V4(1-cos 4phi)],
; which is GROMACS dihedral function type 5 with C1..C4 = V1..V4.
;
; Atom order: S, O1, O2, O3, C, F1, F2, F3.

[ moleculetype ]
; name  nrexcl
OTF     3

[ atoms ]
;  nr   type     resnr  resname  atom   cgnr   charge    mass
   1   clp_SBT     1     OTF     S1     1     1.020   32.066
   2   clp_OTF     1     OTF     O1     1    -0.630   15.999
   3   clp_OTF     1     OTF     O2     1    -0.630   15.999
   4   clp_OTF     1     OTF     O3     1    -0.630   15.999
   5   clp_CBT     1     OTF     C1     1     0.350   12.011
   6   clp_F1      1     OTF     F1     1    -0.160   18.998
   7   clp_F1      1     OTF     F2     1    -0.160   18.998
   8   clp_F1      1     OTF     F3     1    -0.160   18.998

[ bonds ]
; il.ff: SB-OB 1.437 A 5331; CF-SB 1.818 A 1950; FB-CF 1.323 A 3698 (kJ/mol/A^2)
;  ai   aj  funct   b0(nm)   kb(kJ/mol/nm^2)
   1    2    1    0.1437   5.33100e+05
   1    3    1    0.1437   5.33100e+05
   1    4    1    0.1437   5.33100e+05
   1    5    1    0.1818   1.95000e+05
   5    6    1    0.1323   3.69800e+05
   5    7    1    0.1323   3.69800e+05
   5    8    1    0.1323   3.69800e+05

[ pairs ]
; 1-4 pairs O...F across S-C
;  ai   aj  funct
   2    6    1
   2    7    1
   2    8    1
   3    6    1
   3    7    1
   3    8    1
   4    6    1
   4    7    1
   4    8    1

[ angles ]
