;  ai   aj   ak  funct   theta0(deg)   ktheta(kJ/mol/rad^2)
   2    1    3    1   118.50    969.0
   2    1    4    1   118.50    969.0
   3    1    4    1   118.50    969.0
   2    1    5    1   102.60    870.0
   3    1    5    1   102.60    870.0
   4    1    5    1   102.60    870.0
   6    5    7    1   107.10    781.0
   6    5    8    1   107.10    781.0
   7    5    8    1   107.10    781.0
   1    5    6    1   111.70    694.0
   1    5    7    1   111.70    694.0
   1    5    8    1   111.70    694.0

[ dihedrals ]
