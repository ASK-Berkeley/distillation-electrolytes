; Hexafluorophosphate anion, PF6-
;
; Source: CL&P force field (Canongia Lopes & Padua), file il.ff, entries
; "hexafluorophosphate JCSPerkin2 (1999) 2365":
;   Canongia Lopes, Deschamps, Padua, J. Phys. Chem. B 108, 2038 (2004),
;     doi:10.1021/jp0362133   (the CL&P paper that introduces PF6- in the set)
;   Kaminski, Jorgensen, J. Chem. Soc., Perkin Trans. 2, 2365 (1999)
;     (origin of the PF6- bonded parameters)
; CL&P is built on the OPLS-AA functional form: geometric combination rules,
; 1-4 interactions scaled by 0.5, harmonic bonds and angles, V = k/2 (x - x0)^2.
; il.ff gives bonds in kJ/mol/A^2 and angles in kJ/mol/rad^2; the bond constant
; is multiplied by 100 below to get GROMACS' kJ/mol/nm^2.
;
; Charges: P +1.34, F -0.39 (total -1). Lennard-Jones types clp_P / clp_FP are
; defined in the combined forcefield file written by lib/build_system_lpg.py.
;
; Exclusions: every atom in PF6- is within two bonds of every other atom, so
; with nrexcl 3 all 21 pairs are excluded and there are NO 1-4 pairs. The
; [ pairs ] block is therefore absent on purpose. (An earlier version of this
; file had nrexcl 1 plus a [ pairs ] list of all F-F pairs, which gave the F
; atoms 1.5x their normal nonbonded repulsion and stretched P-F to 1.74 A; see
; ../../PF6_TOPOLOGY_BUG.md.)
;
; Angles: an octahedron has 12 cis F-P-F angles (90 deg) and 3 trans angles
; (180 deg). il.ff lists one F-P-F type at 90 deg; a harmonic angle with
; theta0 = 90 cannot describe a linear F-P-F, so the three trans angles use
; theta0 = 180 with the same force constant. Trans pairs: F1/F6, F2/F4, F3/F5.
;
; Atom order: P, then F1..F6.

[ moleculetype ]
; name  nrexcl
PF6     3

[ atoms ]
;  nr   type    resnr  resname  atom   cgnr   charge    mass
   1   clp_P      1     PF6     P      1     1.340   30.974
   2   clp_FP     1     PF6     F1     1    -0.390   18.998
   3   clp_FP     1     PF6     F2     1    -0.390   18.998
   4   clp_FP     1     PF6     F3     1    -0.390   18.998
   5   clp_FP     1     PF6     F4     1    -0.390   18.998
   6   clp_FP     1     PF6     F5     1    -0.390   18.998
   7   clp_FP     1     PF6     F6     1    -0.390   18.998

[ bonds ]
; P-F: r0 1.606 A, k 3100 kJ/mol/A^2 (il.ff) -> 0.1606 nm, 3.1e5 kJ/mol/nm^2
;  ai   aj  funct   b0(nm)   kb(kJ/mol/nm^2)
   1    2    1    0.1606   3.10000e+05
   1    3    1    0.1606   3.10000e+05
   1    4    1    0.1606   3.10000e+05
   1    5    1    0.1606   3.10000e+05
   1    6    1    0.1606   3.10000e+05
   1    7    1    0.1606   3.10000e+05

[ angles ]
; F-P-F: k 1165 kJ/mol/rad^2 (il.ff); theta0 90 (cis) or 180 (trans, see header)
;  ai   aj   ak  funct   theta0(deg)   ktheta(kJ/mol/rad^2)
   2    1    3    1    90.00   1165.0
   2    1    4    1    90.00   1165.0
   2    1    5    1    90.00   1165.0
   2    1    6    1    90.00   1165.0
   2    1    7    1   180.00   1165.0   ; F1-P-F6 trans
   3    1    4    1    90.00   1165.0
   3    1    5    1   180.00   1165.0   ; F2-P-F4 trans
   3    1    6    1    90.00   1165.0
   3    1    7    1    90.00   1165.0
   4    1    5    1    90.00   1165.0
   4    1    6    1   180.00   1165.0   ; F3-P-F5 trans
   4    1    7    1    90.00   1165.0
   5    1    6    1    90.00   1165.0
   5    1    7    1    90.00   1165.0
   6    1    7    1    90.00   1165.0
